# Optional: everything here can also be configured in the web UI (Settings),
# which stores values in data/config.json (gitignored).
# Priority: environment variables > .env > data/config.json.
#   cp .env.example .env

# ── Sentry ──
# SENTRY_BASE_URL=https://sentry.io       # change only for self-hosted Sentry
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_TOKEN=your-readonly-auth-token   # scopes: project:read + event:read

# ── Ingest ──
# STATS_PERIOD_DAYS=90
# DB_PATH=data/triage.db
# MAX_RELEASE_LOOKUPS=50

# ── AI analysis ──
# AI_MODE=claude_cli          # claude_cli (subscription, default) | anthropic_api
# AI_MODEL=sonnet             # sonnet | haiku | opus | full model id
# ANTHROPIC_API_KEY=          # only for anthropic_api mode
# CLI_COMMAND=claude          # point at a compatible wrapper to swap CLIs
# APP_CONTEXT=                # describe YOUR app for better analysis
# OUTPUT_LANGUAGE=en          # en | zh-Hant
# AI_MIN_EVENTS=50            # cost guardrail: skip issues below this
# AI_MAX_ISSUES=20            # cost guardrail: cap per batch

# ── Feature feasibility (AI reads your app repo; claude_cli mode only) ──
# APP_REPO_PATH=

# ── GitHub ──
# GITHUB_REPO=owner/repo
# GITHUB_TOKEN=               # optional PAT; empty = current gh login
# PR_MODEL=sonnet
# GIT_REMOTE=origin           # remote in your app repo that points at GitHub
